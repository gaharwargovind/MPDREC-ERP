# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side only).
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Cryptographic Session & Webhook Signing Secrets (Server-side only)
SESSION_SECRET=
WEBHOOK_SECRET=

# Supabase Server-Side Environment Variables
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Client-Side Environment Variables (Publicly safe anon credentials)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


